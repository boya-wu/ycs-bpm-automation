# =============================================================================
# BPM / Playwright 測試環境變數（範本，可安全提交 git）
# =============================================================================
# 使用方式：
#   cp .env.example .env
#   cp .env.local.example .env.local   # 帳密等機密請只寫在 .env.local
# playwright.config.ts 會先載入 .env，再以 .env.local 覆寫。

# --- BPM 站台與登入 ---
# BPM 首頁/導頁（請保留原本的 query/路徑結構）
BPM_BASE_URL="https://efgp.yuchens.com:8086/NaNaWeb/GP//ForwardIndex?hdnMethod=findIndexForward"
# 工時 PM 設定頁（登入後 goto；可含 empid query）
BPM_WORKITEM_ADD_URL="https://efgp.yuchens.com:8086/NaNaWeb/CustomOpenWin/%E5%B7%A5%E6%99%82PM.jsp?hdnAccessType=15"

# workitemAdder：要建立的專案代號、PM 員工編號
BPM_WORKITEM_PROJECT_CODE="YOUR-PROJECT-CODE"
BPM_PM_EMP_ID="00000000"

# 測試用帳號（密碼請改在 .env.local，勿寫入此檔）
PLAYWRIGHT_BPM_USER="your-bpm-account"
PLAYWRIGHT_BPM_PASSWORD=""

# --- 測試行為開關/安全閥 ---
# 顯示瀏覽器視窗（預設 false＝背景無頭；設 true 可肉眼觀看，僅供除錯，排程勿開）
BPM_HEADED="false"

# 分頁迴圈上限（避免 UI 異常時無限循環）
BPM_MAX_PAGES="100"
BPM_ENABLE_REEXECUTE="false"
# 允許值：0/prev（退回前一關） | 2/first（退回第一關）
BPM_REEXECUTE_TYPE="0"

# --- 測試資料/目標條件（workitemCheck） ---
BPM_TARGET_PROJECT_CODE="YOUR-TARGET-PROJECT"
BPM_APPROVAL_COMMENT="請補上 WorkItem。"

# --- 工時申請單（workreport）---
BPM_PROJ_NO="YOUR-PROJECT-CODE"
BPM_PM_NAME="PM姓名"
BPM_WORK_ITEM="Work Item 文字"
# BPM_WORK_DAY="19"
BPM_WORK_HOUR="8"
BPM_WORK_DESC="日常工作"
