# 本機機密覆寫（複製為 .env.local，勿提交 git）
#   cp .env.local.example .env.local

PLAYWRIGHT_BPM_USER="your-bpm-account"
PLAYWRIGHT_BPM_PASSWORD="your-password-here"

# 若需覆寫範本中的其他變數，可取消註解並填入：
# BPM_BASE_URL="..."
# BPM_WORKITEM_ADD_URL="..."
# BPM_WORKITEM_PROJECT_CODE="YOUR-PROJECT-CODE"
# BPM_PM_EMP_ID="00000000"
